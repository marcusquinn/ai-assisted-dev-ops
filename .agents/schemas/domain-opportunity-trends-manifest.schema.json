{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual Google Trends comparison export manifest",
  "type": "object",
  "required": ["schema_version", "batch_id", "terms", "geography", "timeframe", "timezone", "granularity", "search_property", "category", "language", "share_url", "exported_at", "expected_filename"],
  "properties": {"schema_version": {"const": 1}, "batch_id": {"type": "string"}, "terms": {"type": "array", "minItems": 1, "maxItems": 5}, "geography": {"type": "string"}, "timeframe": {"type": "string"}, "timezone": {"type": "string"}, "granularity": {"type": "string"}, "search_property": {"type": "string"}, "category": {"type": "string"}, "language": {"type": "string"}, "share_url": {"type": "string", "format": "uri"}, "exported_at": {"type": "string", "format": "date-time"}, "expected_filename": {"type": "string"}},
  "additionalProperties": false
}
