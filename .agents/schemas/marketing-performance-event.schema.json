{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketing Performance Event v1",
  "description": "Privacy-safe provider-neutral marketing touchpoint or outcome. Direct source event IDs, remote account IDs, contact destinations, credentials, and provider payloads are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_ref", "event_ref", "source", "event", "subject", "scope", "measurement", "quality", "governance"],
  "properties": {
    "schema_version": {"const": 1},
    "record_ref": {"$ref": "#/$defs/recordRef"},
    "event_ref": {"$ref": "#/$defs/eventRef"},
    "source": {"$ref": "#/$defs/source"},
    "event": {"$ref": "#/$defs/event"},
    "subject": {"$ref": "#/$defs/subject"},
    "scope": {"$ref": "#/$defs/scope"},
    "measurement": {"$ref": "#/$defs/measurement"},
    "quality": {"$ref": "#/$defs/quality"},
    "governance": {"$ref": "#/$defs/governance"}
  },
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "alias": {"type": "string", "pattern": "^(?!(?=(?:[^0-9]*[0-9]){10,15}[^0-9]*$)[0-9._:-]+$)(?!(?:1[-._:]?)?(?:800|833|844|855|866|877|888)[-._:]?[a-z0-9]{7,}$)[a-z0-9][a-z0-9._:-]{0,127}$"},
    "recordRef": {"type": "string", "pattern": "^mkt-record-v1:[a-f0-9]{64}$"},
    "eventRef": {"type": "string", "pattern": "^mkt-event-v1:[a-f0-9]{64}$"},
    "subjectRef": {"type": "string", "pattern": "^mkt-subj-v1:[a-f0-9]{64}$"},
    "evidenceRef": {"type": "string", "pattern": "^mkt-evidence-v1:sha256:[a-f0-9]{64}$"},
    "sourceKind": {"enum": ["campaign", "phase1", "social", "analytics", "crm", "commerce", "outreach", "normalized"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "account_ref", "revision", "observed_at", "recorded_at", "source_observed_at", "source_recorded_at", "evidence_ref", "coverage", "missing_scopes"],
      "properties": {
        "kind": {"$ref": "#/$defs/sourceKind"},
        "account_ref": {"$ref": "#/$defs/alias"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "source_observed_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "source_recorded_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "evidence_ref": {"$ref": "#/$defs/evidenceRef"},
        "coverage": {"enum": ["complete", "partial", "unknown"]},
        "missing_scopes": {"type": "array", "items": {"$ref": "#/$defs/alias"}, "uniqueItems": true}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "occurred_at", "correction_of"],
      "properties": {
        "type": {
          "enum": [
            "impression", "engagement", "follower", "subscriber", "social_receipt", "visit",
            "conversion", "lead_created", "lead_stage", "sale", "revenue",
            "refund", "cost", "outreach_sent", "outreach_reply",
            "outreach_bounce", "unsubscribe", "correction"
          ]
        },
        "occurred_at": {"$ref": "#/$defs/timestamp"},
        "correction_of": {"oneOf": [{"$ref": "#/$defs/eventRef"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "correction"}}},
          "then": {"properties": {"correction_of": {"$ref": "#/$defs/eventRef"}}},
          "else": {"properties": {"correction_of": {"type": "null"}}}
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "kind", "identity_state"],
      "properties": {
        "subject_id": {"oneOf": [{"$ref": "#/$defs/subjectRef"}, {"type": "null"}]},
        "kind": {"enum": ["aggregate", "anonymous", "lead", "contact", "account", "audience"]},
        "identity_state": {"enum": ["not_applicable", "isolated", "linked", "split", "ambiguous"]}
      }
    },
    "nullableAlias": {"oneOf": [{"$ref": "#/$defs/alias"}, {"type": "null"}]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "channel", "creative_id", "touchpoint_id", "outcome_id", "dimensions"],
      "properties": {
        "campaign_id": {"$ref": "#/$defs/nullableAlias"},
        "channel": {"$ref": "#/$defs/nullableAlias"},
        "creative_id": {"$ref": "#/$defs/nullableAlias"},
        "touchpoint_id": {"$ref": "#/$defs/nullableAlias"},
        "outcome_id": {"$ref": "#/$defs/nullableAlias"},
        "dimensions": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": false,
          "patternProperties": {
            "^(?:audience|case_type|cohort|environment|experiment_variant|priority|project_phase|region)$": {
              "oneOf": [
                {"type": "string", "pattern": "^(?!(?=(?:[^0-9]*[0-9]){10,15}[^0-9]*$)[0-9._:-]+$)(?!(?:1[-._:]?)?(?:800|833|844|855|866|877|888)[-._:]?[a-z0-9]{7,}$)(?:[a-z0-9][a-z0-9._:-]{0,127}|mkt-dim-v1:[a-f0-9]{64})$"},
                {
                  "type": "number",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "not": {
                    "anyOf": [
                      {"type": "integer", "minimum": 1000000000, "maximum": 999999999999999},
                      {"type": "integer", "minimum": -999999999999999, "maximum": -1000000000}
                    ]
                  }
                },
                {"type": "boolean"}
              ]
            },
            "^(?!(?:audience|case_type|cohort|environment|experiment_variant|priority|project_phase|region)$)[a-z][a-z0-9_]{0,63}$": {
              "type": "string",
              "pattern": "^mkt-dim-v1:[a-f0-9]{64}$"
            }
          },
          "propertyNames": {
            "allOf": [
              {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
              {"not": {"pattern": "(?:^|_)(?:address|credential|destination|email|first_name|full_name|last_name|name|password|payload|phone|secret|token)(?:_|$)"}},
              {"not": {"enum": ["channel", "creative_id", "touchpoint_id", "outcome_id", "currency"]}}
            ]
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "value", "unit", "aggregation", "currency"],
      "properties": {
        "metric_id": {"type": "string", "pattern": "^marketing\\.[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"},
        "value": {
          "description": "Safe integers remain JSON integers; fractional values use canonical decimal strings to avoid binary rounding.",
          "oneOf": [
            {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
            {"type": "string", "maxLength": 128, "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]*[1-9]$"}
          ]
        },
        "unit": {"enum": ["impression", "engagement", "follower", "subscriber", "receipt", "visit", "conversion", "lead", "sale", "refund", "currency", "message", "reply", "bounce", "unsubscribe", "ratio"]},
        "aggregation": {"enum": ["sum", "average", "latest", "none"]},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "period_start": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "period_end": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"unit": {"const": "currency"}}},
          "then": {"properties": {"currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}},
          "else": {"properties": {"currency": {"type": "null"}}}
        }
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "effective_confidence", "completeness", "source_type", "collected_by", "evidence_ref"],
      "properties": {
        "confidence": {"enum": ["low", "medium", "high", "verified"]},
        "effective_confidence": {"enum": ["low", "medium", "high", "verified"]},
        "completeness": {"enum": ["complete", "partial", "unknown"]},
        "source_type": {"enum": ["manual", "api_export", "csv_export", "derived", "fixture", "agent_estimate", "external_report"]},
        "collected_by": {"$ref": "#/$defs/alias"},
        "evidence_ref": {"$ref": "#/$defs/evidenceRef"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience_eligible", "eligibility_reason"],
      "properties": {
        "audience_eligible": {"type": "boolean"},
        "eligibility_reason": {"enum": ["eligible", "aggregate", "consent_unknown", "consent_denied", "suppressed", "identity_ambiguous", "subject_ineligible"]}
      }
    }
  }
}
